# committed so resources load with correct references.
.godot/

# Editor / OS
*.tmp
*.log
Thumbs.db
.DS_Store

# Backups (never push versioned snapshots)
*.v_2026*
godot3_backup_*/

# Python (bob_server.py deps)
__pycache__/
*.pyc
